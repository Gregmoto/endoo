# Neon PostgreSQL
# Get these from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (Endoo's own subscription billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""          # from "stripe listen --forward-to localhost:3000/api/stripe/webhook"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs (create products in Stripe dashboard first)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Resend (email)
RESEND_API_KEY=""
EMAIL_FROM=""  # e.g. "Endoo <faktura@endoo.se>"

# Cron jobs
CRON_SECRET=""  # openssl rand -base64 32 — used to protect /api/cron/* routes

# Integration platform
INTEGRATION_ENCRYPTION_KEY=""  # openssl rand -hex 32 — AES-256-GCM master key for connector credentials

# Storage (Cloudflare R2 or Vercel Blob)
STORAGE_BUCKET=""
STORAGE_ACCOUNT_ID=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
