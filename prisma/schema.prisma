model ExchangeRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @db.Uuid  // null = global rates fetched by cron
  fromCurrency String   // "EUR"
  toCurrency   String   // "SEK"
  rate         Decimal  @db.Decimal(12, 6)
  rateDate     DateTime @db.Date
  source       String   // "riksbank" | "exchangerate.host" | "manual"
  fetchedAt    DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([fromCurrency, toCurrency, rateDate, source])
  @@index([rateDate])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}
