// ─────────────────────────────────────────────
// ACCOUNTS — Bokföringskonton (chart of accounts)
// TENANT-SCOPED: organization_id required
//
// Each organization gets its own copy of the BAS standard accounts
// (isSystem = true, seeded at onboarding). Organizations may also
// add custom accounts (isSystem = false).
//
// Immutability rules:
//   - System accounts (isSystem=true): name/description editable, number/type NOT
//   - Accounts with journal entries: cannot change number, type, or normalSide
//   - Soft-disable via isActive=false — history is never deleted
// ─────────────────────────────────────────────
model Account {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  // BAS account number — "1510", "3001", etc.
  number String
  name   String    // Swedish BAS name, e.g. "Kundfordringar"

  // Classification
  type       AccountType  // asset | liability | equity | income | expense
  normalSide NormalSide   // debit for assets/expenses, credit for liabilities/equity/income
  reportClass ReportClass // balance_sheet | income_statement

  // Report presentation — Swedish BAS section name
  // e.g. "Omsättningstillgångar", "Kortfristiga skulder", "Rörelsens intäkter"
  reportSection  String?
  reportSubsection String?

  // VAT (moms) code — used when building journal entries
  // MP1=25%, MP2=12%, MP3=6%, MF=exempt, null=not VAT-relevant
  vatCode String?

  // BAS hierarchy
  parentNumber String?  // account group, e.g. "1500" for 1510
  level        Int      @default(3)   // 1=class (1000), 2=group (1500), 3=account (1510)
  sortOrder    Int      @default(0)   // within its level for display ordering

  // Origin — basNumber is set if this account was derived from BAS standard
  basNumber String?
  isSystem  Boolean @default(false)  // BAS standard accounts: number/type protected

  // Status
  isActive         Boolean @default(true)
  allowManualEntry Boolean @default(true)  // false for system-only accounts (e.g. 2069 Årets resultat)

  description String?  // public-facing explanation shown in UI
  notes       String?  // internal accountant notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries    JournalEntry[]
  dimensionRules    AccountDimensionRule[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, reportClass])
  @@index([organizationId, isActive])
  @@index([organizationId, isSystem])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// FISCAL YEAR — Räkenskapsår
// TENANT-SCOPED: organization_id required
// Journals must fall within an open fiscal year.
// ─────────────────────────────────────────────
model FiscalYear {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  name           String           // "2025" or "2024/2025" for broken fiscal year
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  status         FiscalYearStatus @default(open)
  isDefault      Boolean          @default(false)

  // Year-end closing fields (populated by closeFiscalYear)
  closingJournalId  String?  @db.Uuid  // FK to the resultatdisposition journal (3xxx-8xxx→2099)
  openingJournalId  String?  @db.Uuid  // FK to the IB journal for the next fiscal year
  closingHash       String?            // SHA-256 of the immutable snapshot payload
  closedAt          DateTime?
  closedById        String?  @db.Uuid
  reopenedAt        DateTime?
  reopenedById      String?  @db.Uuid

  // Immutable snapshots stored at closing time (JSON)
  closedBalanceSheetSnapshot   Json?    // AccountSnapshot[] for balance-sheet accounts
  closedIncomeStatementSnapshot Json?   // AccountSnapshot[] for income-statement accounts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journals          Journal[]
  accountingPeriods AccountingPeriod[]
  closedBy          User?             @relation("FiscalYearClosedBy",   fields: [closedById],   references: [id])
  reopenedBy        User?             @relation("FiscalYearReopenedBy", fields: [reopenedById], references: [id])
  sruExports        SruExport[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
  @@map("fiscal_years")
}

// ─────────────────────────────────────────────
// JOURNAL SERIES — Verifikationsserie
// TENANT-SCOPED: organization_id required
// Each prefix (A, K, L...) has its own sequence counter.
// The counter is incremented atomically inside a transaction.
// ─────────────────────────────────────────────
model JournalSeries {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  prefix         String         // "A" general, "K" cash, "L" payroll
  name           String         // "Allmänna verifikationer"
  currentSeq     Int    @default(0)
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journals     Journal[]

  @@unique([organizationId, prefix])
  @@index([organizationId])
  @@map("journal_series")
}

// ─────────────────────────────────────────────
// JOURNAL — Verifikation (header)
// TENANT-SCOPED: organization_id required
//
// Immutability rules (enforced at app layer + DB trigger):
//   draft   → editable, not in reports
//   posted  → immutable (only voidedBy can be added via void flow)
//   voided  → immutable, reversed by a later journal
//
// To correct a posted journal: call voidJournal() which creates
// a reversing journal (mirrored debit/credit) and sets status=voided.
// ─────────────────────────────────────────────
model Journal {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  fiscalYearId   String        @db.Uuid
  seriesId       String        @db.Uuid

  number    Int    // sequence within series (from JournalSeries.currentSeq)
  reference String // "A-0001" — denormalized for display and search

  periodId    String?       @db.Uuid // FK to AccountingPeriod (null = pre-period feature)

  date        DateTime      @db.Date // bokföringsdatum
  description String        // verifikationstext
  status      JournalStatus @default(draft)
  voidReason  String?       // populated when status = voided

  // Source document link (polymorphic — set by auto-booking engine)
  sourceType String? // "invoice" | "payment" | "credit_note" | "manual"
  sourceId   String? @db.Uuid

  // Void / reversal links (self-relation)
  // voidOf: this journal reverses the journal with that id
  // reversals: journals that reverse this journal (0 or 1 in practice)
  voidOf String? @db.Uuid

  postedAt       DateTime?
  postedByUserId String?   @db.Uuid

  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear      FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  series          JournalSeries     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  period          AccountingPeriod? @relation(fields: [periodId], references: [id])
  entries         JournalEntry[]
  postedBy        User?             @relation("JournalPostedBy",   fields: [postedByUserId],  references: [id])
  createdBy       User?             @relation("JournalCreatedBy",  fields: [createdByUserId], references: [id])

  // Self-relation: reversal chain
  reversedJournal Journal?  @relation("JournalReversal", fields: [voidOf], references: [id])
  reversals       Journal[] @relation("JournalReversal")

  @@unique([organizationId, seriesId, number])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([organizationId, sourceType, sourceId])
  @@index([fiscalYearId])
  @@map("journals")
}

// ─────────────────────────────────────────────
// JOURNAL ENTRY — Verifikationsrad
// TENANT-SCOPED: organization_id required
//
// Each row is either debit OR credit — never both.
// Enforced at app layer (validateEntries) and via DB check constraint.
//
// Immutable once the parent journal is posted.
// ─────────────────────────────────────────────
model JournalEntry {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  journalId      String @db.Uuid
  accountId      String @db.Uuid

  debit  BigInt @default(0) // öre — zero when this is a credit entry
  credit BigInt @default(0) // öre — zero when this is a debit entry

  description String? // line description (optional, overrides journal description in ledger)
  vatCode     String? // "MP1" | "MP2" | "MP3" | "MF" — for VAT reporting
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal      Journal                 @relation(fields: [journalId],      references: [id], onDelete: Restrict)
  account      Account                 @relation(fields: [accountId],      references: [id], onDelete: Restrict)
  dimensions   JournalEntryDimension[]

  @@index([organizationId, journalId])
  @@index([organizationId, accountId])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("journal_entries")
}

// ─────────────────────────────────────────────
// DIMENSION AXIS — Dimensionsaxel
// TENANT-SCOPED: organizationId required
//
// Defines a classification axis (e.g. "Kostnadsställe", "Projekt").
// Three built-in axes (cc, project, unit) are seeded per org.
// Custom axes require no schema changes.
// ─────────────────────────────────────────────
model DimensionAxis {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid

  code      String   // "cc" | "project" | "unit" | custom slug
  name      String   // "Kostnadsställe"
  isBuiltIn Boolean  @default(false)  // built-in axes cannot be deleted
  isRequired Boolean @default(false)  // require on every journal entry
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dimensions     Dimension[]
  accountRules   AccountDimensionRule[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("dimension_axes")
}

// ─────────────────────────────────────────────
// DIMENSION — Dimensionsvärde
// TENANT-SCOPED: organizationId required
//
// A specific value within an axis, e.g. "IT-avdelningen" within "cc".
// Project-specific fields (budget, dates, status) are ignored for cc/unit.
// ─────────────────────────────────────────────
model Dimension {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  axisId         String  @db.Uuid

  code        String        // "CC001", "PROJ-042"
  name        String        // "IT-avdelningen", "Projekt Alpha"
  description String?
  parentId    String?  @db.Uuid  // for hierarchical cost centers
  isActive    Boolean  @default(true)

  // Project-specific (ignored for cc / unit axes)
  budget    BigInt?       // budgeted amount in öre
  startDate DateTime?     @db.Date
  endDate   DateTime?     @db.Date
  status    ProjectStatus @default(active)
  ownerId   String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  axis                  DimensionAxis             @relation(fields: [axisId], references: [id], onDelete: Restrict)
  parent                Dimension?                @relation("DimensionHierarchy", fields: [parentId], references: [id])
  children              Dimension[]               @relation("DimensionHierarchy")
  owner                 User?                     @relation("DimensionOwner", fields: [ownerId], references: [id])
  journalEntryDimensions JournalEntryDimension[]
  invoiceLineDimensions  InvoiceLineItemDimension[]
  supplierInvoiceDimensions SupplierInvoiceDimension[]

  @@unique([organizationId, axisId, code])
  @@index([organizationId, axisId, isActive])
  @@index([organizationId, status])
  @@map("dimensions")
}

// ─────────────────────────────────────────────
// JOURNAL ENTRY DIMENSION — Verifikationsraddimension
// TENANT-SCOPED: organizationId required
//
// Links a journal entry line to a dimension with an allocation percentage.
// Snapshots freeze code/name at tagging time for audit integrity.
// SUM(percentage per axisId per journalEntryId) must equal 100.
// Immutable when the accounting period is locked (enforced at app layer).
// ─────────────────────────────────────────────
model JournalEntryDimension {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  journalEntryId String  @db.Uuid
  dimensionId    String  @db.Uuid

  percentage Decimal @default(100.00) @db.Decimal(7, 4) // 0.0001–100.0000

  // Immutable snapshots — frozen at creation, never updated
  dimensionCodeSnapshot String  // e.g. "PROJ-042"
  dimensionNameSnapshot String  // e.g. "Projekt Alpha"
  axisCodeSnapshot      String  // e.g. "project"

  // Force flag: allows mutation in locked period by super_admin
  // Logged in audit trail
  forcedByUserId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  dimension    Dimension    @relation(fields: [dimensionId],    references: [id], onDelete: Restrict)
  forcedBy     User?        @relation("DimensionForceUser", fields: [forcedByUserId], references: [id])

  @@unique([journalEntryId, dimensionId])
  @@index([organizationId, journalEntryId])
  @@index([organizationId, dimensionId])
  @@map("journal_entry_dimensions")
}

// ─────────────────────────────────────────────
// INVOICE LINE ITEM DIMENSION
// TENANT-SCOPED: organizationId required
// Propagated → JournalEntryDimension when invoice is posted.
// ─────────────────────────────────────────────
model InvoiceLineItemDimension {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  lineItemId     String  @db.Uuid
  dimensionId    String  @db.Uuid

  percentage Decimal @default(100.00) @db.Decimal(7, 4)

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItem     InvoiceLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  dimension    Dimension       @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@unique([lineItemId, dimensionId])
  @@index([organizationId, lineItemId])
  @@map("invoice_line_item_dimensions")
}

// ─────────────────────────────────────────────
// SUPPLIER INVOICE DIMENSION
// TENANT-SCOPED: organizationId required
// Header-level dimensions for supplier invoices (no line items in MVP).
// ─────────────────────────────────────────────
model SupplierInvoiceDimension {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @db.Uuid
  supplierInvoiceId String @db.Uuid
  dimensionId      String  @db.Uuid

  percentage Decimal @default(100.00) @db.Decimal(7, 4)

  createdAt DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  dimension       Dimension       @relation(fields: [dimensionId],       references: [id], onDelete: Restrict)

  @@unique([supplierInvoiceId, dimensionId])
  @@index([organizationId, supplierInvoiceId])
  @@map("supplier_invoice_dimensions")
}

// ─────────────────────────────────────────────
// ACCOUNT DIMENSION RULE
// TENANT-SCOPED: organizationId required
//
// Defines which dimension axes are required for entries on a given account.
// e.g. account 4xxx requires "project" axis, account 7xxx requires "cc" axis.
// Validated at post time (postInvoiceSent, postInvoicePaid, manual entry).
// ─────────────────────────────────────────────
model AccountDimensionRule {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  accountId      String  @db.Uuid
  axisId         String  @db.Uuid

  isRequired Boolean @default(true)  // false = allowed but not required

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId],      references: [id], onDelete: Cascade)
  axis         DimensionAxis @relation(fields: [axisId],         references: [id], onDelete: Cascade)

  @@unique([accountId, axisId])
  @@index([organizationId, accountId])
  @@map("account_dimension_rules")
}

// ═══════════════════════════════════════════════
// INTEGRATIONS — external system connections
// ═══════════════════════════════════════════════

// ─────────────────────────────────────────────
// CONNECTION — tenant connection to an external system
// TENANT-SCOPED: organizationId required
//
// Credentials are encrypted (AES-256-GCM) before storage.
// Never store plaintext tokens.
// ─────────────────────────────────────────────
model Connection {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  integrationSlug String          // "shopify" | "stripe" | "klarna" | "fortnox_import"
  status         ConnectionStatus @default(pending)
  displayName    String?          // user-facing label, e.g. "Min Shopify-butik"

  // Encrypted credentials (AES-256-GCM + per-connection IV, stored as base64)
  encryptedAccessToken  String?  @db.Text
  encryptedRefreshToken String?  @db.Text
  tokenExpiresAt        DateTime?
  encryptedApiKey       String?  @db.Text
  webhookSecret         String?  // HMAC secret for incoming webhook verification
  encryptionIv          String?  // base64 IV used for this connection's credentials

  // Integration-specific config (shop domain, account mappings, etc.)
  config         Json?

  // Sync state
  lastSyncAt      DateTime?
  lastSyncCursor  String?    // cursor for incremental sync resume
  syncIntervalMin Int        @default(60)

  // Error tracking
  lastErrorAt      DateTime?
  lastErrorMessage String?   @db.Text
  errorCount       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEvents  WebhookEvent[]
  syncJobs       SyncJob[]
  logs           IntegrationLog[]
  entityMaps     ExternalEntityMap[]
  importFiles    ImportFile[]

  @@index([organizationId, integrationSlug])
  @@index([organizationId, status])
  @@map("connections")
}

// ─────────────────────────────────────────────
// WEBHOOK EVENT — immutable incoming event log
// TENANT-SCOPED: organizationId required
//
// Written immediately on receipt; processed async.
// Never modified after creation except status fields.
// ─────────────────────────────────────────────
model WebhookEvent {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @db.Uuid
  connectionId    String             @db.Uuid
  externalEventId String?            // provider's own event ID (dedup key)
  topic           String             // "orders/paid", "payment_intent.succeeded"
  rawPayload      Json               // full body as received — append-only
  signatureHeader String?            // raw sig header stored for audit
  signatureValid  Boolean

  status          WebhookEventStatus @default(pending)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime?          @default(now())
  processedAt     DateTime?
  errorMessage    String?            @db.Text

  // Result — entity created or updated as a result of this webhook
  resultEntityType String?
  resultEntityId   String?           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId],   references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([organizationId, status, nextAttemptAt])
  @@index([connectionId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────
// SYNC JOB — background sync job record
// TENANT-SCOPED: organizationId required
// ─────────────────────────────────────────────
model SyncJob {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  connectionId   String        @db.Uuid
  jobType        String        // "orders" | "customers" | "payments" | "products"
  status         SyncJobStatus @default(pending)

  cursor         String?       // resume cursor updated per batch
  rangeFrom      DateTime?
  rangeTo        DateTime?

  itemsTotal     Int?
  itemsOk        Int           @default(0)
  itemsFailed    Int           @default(0)
  errorMessage   String?       @db.Text

  triggeredBy    String?       // "cron" | "manual" | userId
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId],   references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([connectionId, status])
  @@map("sync_jobs")
}

// ─────────────────────────────────────────────
// INTEGRATION LOG — human-readable audit trail
// TENANT-SCOPED: organizationId required
// ─────────────────────────────────────────────
model IntegrationLog {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  connectionId   String  @db.Uuid
  eventType      String  // "connected" | "sync_started" | "webhook_processed" | "token_refreshed" | "error"
  message        String
  meta           Json?
  userId         String? @db.Uuid  // null for automated events

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId],   references: [id], onDelete: Cascade)

  @@index([organizationId, connectionId])
  @@index([connectionId, createdAt(sort: Desc)])
  @@map("integration_logs")
}

// ─────────────────────────────────────────────
// EXTERNAL ENTITY MAP — external ↔ internal ID mapping
// TENANT-SCOPED: organizationId required
//
// Prevents duplicate imports and tracks sync state per entity.
// checksum = SHA-256 of relevant external fields — enables change detection.
// ─────────────────────────────────────────────
model ExternalEntityMap {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  connectionId   String  @db.Uuid
  externalType   String  // "order" | "customer" | "payment" | "product" | "journal"
  externalId     String  // provider's entity ID
  internalType   String  // "Invoice" | "Contact" | "Payment" | "Product"
  internalId     String  @db.Uuid  // Endoo entity UUID
  checksum       String  // SHA-256 of mapped fields — change detection
  syncedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId],   references: [id], onDelete: Cascade)

  @@unique([connectionId, externalType, externalId])
  @@index([organizationId, internalType, internalId])
  @@map("external_entity_maps")
}

// ─────────────────────────────────────────────
// IMPORT FILE — file import deduplication
// TENANT-SCOPED: organizationId required
//
// fileHash (SHA-256) prevents re-importing the same file.
// status = preview until user confirms; committed = fully imported.
// ─────────────────────────────────────────────
model ImportFile {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  connectionId   String           @db.Uuid
  integrationSlug String          // "fortnox_import" | "visma_import"
  fileName       String
  fileSize       Int              // bytes
  fileHash       String           // SHA-256 of raw file — dedup key
  status         ImportFileStatus @default(preview)
  previewData    Json?            // parsed preview (accounts, journals, contacts counts)
  importResult   Json?            // { created, skipped, errors } on commit
  importedByUserId String?        @db.Uuid
  errorMessage   String?          @db.Text

  createdAt   DateTime @default(now())
  committedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   Connection   @relation(fields: [connectionId],   references: [id], onDelete: Cascade)
  importedBy   User?        @relation("ImportFileUser", fields: [importedByUserId], references: [id])

  @@unique([organizationId, fileHash])
  @@index([organizationId, status])
  @@map("import_files")
}

// ─────────────────────────────────────────────
// ACCOUNTING PERIOD — Bokföringsperiod (månadsvis)
// TENANT-SCOPED: organizationId required
//
// Created lazily on first journal post to that month.
// Journals within a locked/closed period are rejected by assertPeriodOpen().
// Locking captures an immutable snapshot (debit/credit totals, journal count).
// ─────────────────────────────────────────────
model AccountingPeriod {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @db.Uuid
  fiscalYearId   String                 @db.Uuid
  year           Int                    // 2026
  month          Int                    // 1–12
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  status         AccountingPeriodStatus @default(open)

  lockedAt       DateTime?
  lockedByUserId String?   @db.Uuid
  closedAt       DateTime?
  closedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear            @relation(fields: [fiscalYearId],   references: [id], onDelete: Restrict)
  lockedBy     User?                 @relation("PeriodLockedBy",  fields: [lockedByUserId],  references: [id])
  closedBy     User?                 @relation("PeriodClosedBy",  fields: [closedByUserId],  references: [id])
  journals     Journal[]
  snapshot     AccountingPeriodSnapshot?
  events       AccountingPeriodEvent[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@index([organizationId, fiscalYearId])
  @@map("accounting_periods")
}

// ─────────────────────────────────────────────
// ACCOUNTING PERIOD SNAPSHOT — Periodavstämning
// Created atomically when a period is locked.
// Immutable after creation — never updated.
// ─────────────────────────────────────────────
model AccountingPeriodSnapshot {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  periodId       String @unique @db.Uuid

  totalDebit   BigInt  // sum of all debit entries in posted journals
  totalCredit  BigInt  // sum of all credit entries in posted journals
  journalCount Int     // number of posted journals
  voidedCount  Int     // number of voided journals
  snapshotHash String  // SHA-256(periodId:totalDebit:totalCredit:journalCount:voidedCount)

  createdAt DateTime @default(now())

  period AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@map("accounting_period_snapshots")
}

// ─────────────────────────────────────────────
// ACCOUNTING PERIOD EVENT — Periodhändelselogg
// Append-only audit trail for every period state change.
// ─────────────────────────────────────────────
model AccountingPeriodEvent {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @db.Uuid
  periodId       String                    @db.Uuid
  eventType      AccountingPeriodEventType
  userId         String?                   @db.Uuid
  reason         String?                   // mandatory for unlock
  meta           Json?

  createdAt DateTime @default(now())

  period       AccountingPeriod @relation(fields: [periodId],       references: [id], onDelete: Restrict)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation("PeriodEventUser", fields: [userId], references: [id])

  @@index([organizationId, periodId])
  @@index([organizationId, eventType])
  @@map("accounting_period_events")
}

// ─────────────────────────────────────────────
// SUPPLIER — leverantörsregister
// TENANT-SCOPED: organizationId required
// ─────────────────────────────────────────────
model Supplier {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid

  name           String
  orgNumber      String?   // 556000-0000 (Swedish org number)
  vatNumber      String?   // SE556000000001
  email          String?
  phone          String?
  website        String?

  // Payment details
  bankgiro       String?
  plusgiro       String?
  iban           String?
  bic            String?

  address        Json?     // { street, city, postalCode, country }

  paymentTermsDays            Int     @default(30)
  defaultExpenseAccountNumber String? // e.g. "6420" — pre-fills kontering

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       SupplierInvoice[]

  @@unique([organizationId, orgNumber])
  @@index([organizationId])
  @@index([organizationId, name])
  @@map("suppliers")
}

// ─────────────────────────────────────────────
// SUPPLIER INVOICE — inkommande leverantörsfaktura
// TENANT-SCOPED: organizationId required
//
// Lifecycle: draft → extracting → needs_review → approved → booked → paid
// Idempotency keys prevent double extraction/booking/payment.
// Duplicate detection via duplicateHash (supplier+invoiceNumber+amount).
// ─────────────────────────────────────────────
model SupplierInvoice {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  supplierId     String? @db.Uuid  // null until matched to Supplier

  status         SupplierInvoiceStatus @default(draft)

  // ── Original file ─────────────────────────────────────────────────────────
  fileKey        String   // Vercel Blob or R2 object key
  fileName       String
  fileMimeType   String   // "application/pdf" | "image/jpeg" | "image/png"
  fileUploadedAt DateTime @default(now())

  // ── AI extraction metadata ────────────────────────────────────────────────
  extractionStatus   ExtractionStatus @default(pending)
  aiModel            String?          // "claude-sonnet-4-6"
  aiVersion          String?          // Anthropic API model version string
  aiPromptVersion    String?          // "v1" — bump when prompt changes
  aiProcessedAt      DateTime?
  ocrRawText         String?          @db.Text
  aiExtractedData    Json?            // raw structured output from Claude
  aiConfidence       Json?            // { field: 0.0–1.0 } confidence per field

  // ── Idempotency keys (unique — DB enforces single execution) ──────────────
  extractionIdempotencyKey  String? @unique  // set before calling Claude; cleared on failure
  bookingIdempotencyKey     String? @unique  // set when booking starts
  paymentIdempotencyKey     String? @unique  // set when payment journal starts

  // ── Verified fields (user-confirmed after AI review) ─────────────────────
  supplierName      String?
  supplierOrgNumber String?
  supplierVatNumber String?
  invoiceNumber     String?
  ocrNumber         String?   // OCR/referensnummer för bankgiro
  invoiceDate       DateTime? @db.Date
  dueDate           DateTime? @db.Date
  currency          String    @default("SEK")
  amountExclVat     BigInt?   // öre
  vatAmount         BigInt?   // öre
  amountInclVat     BigInt?   // öre
  vatRate           Decimal?  @db.Decimal(5, 4)  // 0.2500
  bankgiro          String?
  plusgiro          String?
  iban              String?

  // ── Duplicate detection ───────────────────────────────────────────────────
  // Hash of (organizationId + supplierId/supplierOrgNumber + invoiceNumber + amountInclVat)
  // Recomputed after user confirms fields.
  duplicateHash    String?    // SHA-256 hex
  duplicateOf      String?    @db.Uuid  // FK to original if this IS a duplicate
  duplicateCheckAt DateTime?

  // ── Booking ───────────────────────────────────────────────────────────────
  journalId        String?   @db.Uuid  // FK to Journal once booked
  bookedAt         DateTime?
  bookedByUserId   String?   @db.Uuid

  // ── Payment ───────────────────────────────────────────────────────────────
  paidAt              DateTime?
  paidAmount          BigInt?
  paymentMethod       PaymentMethod?
  paymentReference    String?
  paymentJournalId    String?  @db.Uuid  // FK to the payment Journal
  paidByUserId        String?  @db.Uuid

  // ── Approval (prepared for attest flow — Fas 2) ───────────────────────────
  approvedAt        DateTime?
  approvedByUserId  String?  @db.Uuid
  rejectedAt        DateTime?
  rejectedByUserId  String?  @db.Uuid
  rejectionReason   String?

  // ── Audit ─────────────────────────────────────────────────────────────────
  createdByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier?                @relation(fields: [supplierId],     references: [id])
  approvalRequests ApprovalRequest[]
  dimensions       SupplierInvoiceDimension[]
  fixedAssets      FixedAsset[]

  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@index([organizationId, dueDate])
  @@index([organizationId, invoiceDate])
  @@index([duplicateHash])
  @@index([organizationId, supplierId, invoiceNumber])
  @@map("supplier_invoices")
}

// ─────────────────────────────────────────────
// VAT PERIOD — Momsredovisningsperiod
// TENANT-SCOPED: organization_id required
// When locked: amounts are frozen and cannot change.
// ─────────────────────────────────────────────
model VatPeriod {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  periodType     VatPeriodType
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  status         VatPeriodStatus @default(open)

  // Calculated amounts (öre) — null until calculated, frozen when locked
  box05 BigInt?  // Momspliktiga försäljningar 25% (underlag)
  box06 BigInt?  // Momspliktiga försäljningar 12%
  box07 BigInt?  // Momspliktiga försäljningar 6%
  box10 BigInt?  // Utgående moms 25%
  box11 BigInt?  // Utgående moms 12%
  box12 BigInt?  // Utgående moms 6%
  box48 BigInt?  // Ingående moms (avdragsgill)
  box49 BigInt?  // Att betala (positiv) / Att återfå (negativ)

  // Snapshot hash (SHA-256 of amounts when locked)
  snapshotHash   String?

  calculatedAt       DateTime?
  submittedAt        DateTime?
  submittedByUserId  String?   @db.Uuid
  lockedAt           DateTime?
  lockedByUserId     String?   @db.Uuid

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
  @@index([organizationId, periodStart])
  @@map("vat_periods")
}

// ─────────────────────────────────────────────
// INVENTORY ITEM — Lagervara
// TENANT-SCOPED: organization_id required
// One InventoryItem per Product (1-1, only for physical goods).
// Stock level is always computed query-time from InventoryTransaction rows.
// ─────────────────────────────────────────────
model InventoryItem {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  productId      String     @unique @db.Uuid

  unitOfMeasure  String     @default("st")
  costMethod     CostMethod @default(average)
  standardCost   BigInt?    // öre/enhet — används om costMethod=standard
  reorderPoint   Decimal?   @db.Decimal(12, 4)  // varning under denna nivå
  warehouseNote  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([organizationId])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────
// INVENTORY TRANSACTION — Lagertransaktion
// TENANT-SCOPED: organization_id required
// Append-only ledger. Never update or delete rows.
// Corrections via new adjustment rows (mirror).
// ─────────────────────────────────────────────
model InventoryTransaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  itemId         String          @db.Uuid

  type           InventoryTxType
  quantity       Decimal         @db.Decimal(12, 4)  // + = inleverans, - = utleverans
  unitCost       BigInt          @default(0)          // öre per enhet
  totalCost      BigInt          @default(0)          // abs(quantity) × unitCost

  // Source document (optional)
  sourceType     String?   // "invoice" | "supplier_invoice" | "manual" | "count"
  sourceId       String?   @db.Uuid

  memo           String?
  transactedAt   DateTime  @db.Date
  createdAt      DateTime  @default(now())
  createdByUserId String?  @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId, transactedAt])
  @@index([organizationId, type])
  @@index([organizationId, sourceType, sourceId])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// API KEYS — External API access tokens
// TENANT-SCOPED: organization_id required
// keyHash is SHA-256 of the raw key (never stored plain).
// keyPrefix is the first 8 chars of the raw key (shown in UI).
// ─────────────────────────────────────────────
model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid

  name           String                // user-given label, e.g. "Zapier integration"
  keyPrefix      String                // first 8 chars of raw key — shown in UI
  keyHash        String    @unique     // SHA-256(rawKey) — used for lookup
  scopes         String[]              // ["invoices:read", "contacts:read", ...]
  environment    ApiKeyEnv @default(live)
  rateLimit      Int?                  // requests/minute; null = org default (60)

  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  revokedAt      DateTime?
  revokedByUserId String?  @db.Uuid

  createdByUserId String?  @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─────────────────────────────────────────────
// IDEMPOTENCY KEYS — Prevent duplicate API writes
// TENANT-SCOPED: organization_id required
// Keyed by (organizationId, key) — key is caller-supplied token.
// Response is cached so retries with the same key get the same reply.
// ─────────────────────────────────────────────
model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid

  key            String               // caller-supplied idempotency token
  method         String               // HTTP method
  path           String               // request path
  requestHash    String               // SHA-256 of request body (detects body mismatch)
  responseBody   Json?                // cached response payload
  statusCode     Int?                 // cached HTTP status

  createdAt      DateTime @default(now())
  expiresAt      DateTime             // auto-purge after 24h via cron

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────
// APPROVAL WORKFLOW — Attestation module
// ─────────────────────────────────────────────

// Policy template: defines the approval chain for an org
model ApprovalPolicy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid

  name           String
  description    String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)

  // Auto-approve invoices below this amount (öre); null = never auto-approve
  autoApproveBelow BigInt?

  createdByUserId String?  @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps          ApprovalPolicyStep[]
  requests       ApprovalRequest[]

  @@index([organizationId, isDefault])
  @@index([organizationId, isActive])
  @@map("approval_policies")
}

// One step in an approval chain (e.g. "Manager sign-off", "CFO approval")
model ApprovalPolicyStep {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId String @db.Uuid

  stepOrder      Int
  name           String

  approverType   ApproverType
  specificUserId String?      @db.Uuid   // set when approverType = specific_user
  approverRole   MemberRole?             // set when approverType = role_based

  completionRule CompletionRule @default(any_one)

  // Amount filter: null = applies to all amounts
  amountMin      BigInt?   // öre, inclusive
  amountMax      BigInt?   // öre, inclusive

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, stepOrder])
  @@map("approval_policy_steps")
}

// One attest round for a supplier invoice
model ApprovalRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  supplierInvoiceId String @db.Uuid
  policyId        String?  @db.Uuid   // null if policy was deleted after submission

  // Snapshot of policy+steps at submission time (immutable audit trail)
  policySnapshot  Json

  status          ApprovalRequestStatus @default(in_progress)
  round           Int                   @default(1)  // increments on resubmission

  submittedByUserId String  @db.Uuid
  submittedAt       DateTime @default(now())
  completedAt       DateTime?
  withdrawnAt       DateTime?
  withdrawnByUserId String?  @db.Uuid

  rejectionReason String?
  // SHA-256 of the invoice file at submission — detects tampering
  documentHash    String?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  policy          ApprovalPolicy? @relation(fields: [policyId], references: [id])
  steps           ApprovalStep[]

  @@index([organizationId, status])
  @@index([organizationId, supplierInvoiceId])
  @@index([supplierInvoiceId, round])
  @@map("approval_requests")
}

// One step instance within an active approval request
model ApprovalStep {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  requestId      String   @db.Uuid

  stepOrder      Int
  name           String
  completionRule CompletionRule

  // Resolved at submission time from the policy step definition
  resolvedApproverIds String[]   // UUID[]

  status         ApprovalStepStatus @default(pending)
  activatedAt    DateTime?
  completedAt    DateTime?

  // Reminder tracking
  lastReminderSentAt DateTime?
  reminderCount      Int       @default(0)

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  votes   ApprovalVote[]

  @@index([requestId, stepOrder])
  @@index([organizationId, status])
  @@map("approval_steps")
}

// An individual vote on a step (immutable — never updated)
model ApprovalVote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  stepId         String   @db.Uuid

  voterUserId    String   @db.Uuid
  actingForUserId String? @db.Uuid  // set if voter is acting on behalf of someone

  decision  VoteDecision
  comment   String?      @db.Text

  votedAt DateTime @default(now())

  step ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // One vote per voter per step (idempotency enforced at DB level)
  @@unique([stepId, voterUserId])
  @@index([organizationId, stepId])
  @@index([voterUserId])
  @@map("approval_votes")
}

// ─────────────────────────────────────────────
// NOTIFICATION & ACTIVITY SYSTEM
// ─────────────────────────────────────────────

// Immutable event log — the source of truth. Never updated or deleted.
model NotificationEvent {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @db.Uuid
  type            NotificationEventType
  actorUserId     String?               @db.Uuid   // null for scheduled/system events
  entityType      String                            // "Invoice", "Payment", "SupplierInvoice" …
  entityId        String                            // UUID as string (polymorphic)
  payload         Json                              // rich context; validated by Zod in dispatcher
  eventFingerprint String                           // SHA-256 deduplication key

  createdAt       DateTime              @default(now())

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedItems       ActivityFeedItem[]
  notifications   Notification[]

  @@unique([organizationId, eventFingerprint])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, entityId, createdAt])
  @@map("notification_events")
}

// Org-wide activity stream — all members with read access can see this.
// Titles/hrefs are pre-computed at write time for fast display.
model ActivityFeedItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @db.Uuid
  eventId         String    @db.Uuid
  actorUserId     String?   @db.Uuid
  entityType      String
  entityId        String
  title           String                // "Faktura INV-042 betalad"
  body            String?               // optional detail line
  href            String?               // "/invoices/{id}" — deep link
  iconKey         String?               // "invoice_paid" — maps to icon in UI
  category        String                // matches preference category key

  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           NotificationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityId])
  @@map("activity_feed_items")
}

// Per-user in-app notification inbox — powers the bell icon.
model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String    @db.Uuid
  eventId         String    @db.Uuid

  title           String
  body            String?
  href            String?
  iconKey         String?
  category        String

  readAt          DateTime?
  dismissedAt     DateTime?
  emailSentAt     DateTime?
  emailJobId      String?   @db.Uuid

  createdAt       DateTime  @default(now())

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           NotificationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, organizationId, readAt, createdAt])
  @@index([organizationId, eventId])
  @@map("notifications")
}

// Email delivery queue — processed by cron, retry with backoff.
model NotificationJob {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @db.Uuid
  userId          String                @db.Uuid
  notificationId  String?               @db.Uuid   // link to Notification row (null for system jobs)
  channel         String                @default("email")
  template        NotificationTemplate
  payload         Json                              // all data needed to render; no DB calls at send time
  status          NotificationJobStatus @default(pending)
  attempts        Int                   @default(0)
  maxAttempts     Int                   @default(5)
  nextAttemptAt   DateTime              @default(now())
  processedAt     DateTime?
  error           String?               @db.Text

  createdAt       DateTime              @default(now())

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDeliveries EmailDelivery[]

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@index([organizationId, createdAt])
  @@map("notification_jobs")
}

// ─────────────────────────────────────────────
// AI ENUMS
// ─────────────────────────────────────────────

enum AiFeature {
  receipt_scan      // extract data from a receipt/invoice image
  account_suggest   // suggest debit/credit accounts for a description
  journal_suggest   // full journal entry proposal for a supplier invoice
  anomaly_detect    // flag anomalies in existing transactions
  explain           // explain an accounting concept or account
}

enum AiSuggestionStatus {
  pending    // awaiting human review
  accepted   // approved as-is
  modified   // approved after user changed fields
  rejected   // user explicitly rejected
  expired    // auto-expired after 7 days without review
}

enum AnomalyType {
  duplicate_invoice   // same vendor + amount within a short window
  amount_outlier      // amount > 3σ from vendor's historical invoices
  wrong_account       // unusual account for this vendor/category
  vat_mismatch        // VAT rate inconsistent with item category
}

enum AnomalySeverity {
  info
  warning
  error
}

enum AnomalyStatus {
  open
  acknowledged
  resolved
  false_positive
}

// ─────────────────────────────────────────────
// AI SUGGESTION — stores each AI proposal pending human review
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────
model AiSuggestion {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @db.Uuid
  createdByUserId String             @db.Uuid

  feature         AiFeature
  sourceType      String             // "supplier_invoice" | "journal_entry" | "receipt" | "manual"
  sourceId        String?            // FK to source record (nullable for ad-hoc)

  // The structured suggestion payload (varies by feature)
  suggestion      Json
  confidence      Float              // 0–1 computed score
  confidenceBreakdown Json           // per-signal scores

  status          AiSuggestionStatus @default(pending)
  reviewedByUserId String?
  reviewedAt      DateTime?
  modifiedFields  Json?              // which fields the user changed before accepting
  rejectionReason String?

  // Telemetry
  modelId         String             @default("claude-sonnet-4-6")
  promptTokens    Int                @default(0)
  completionTokens Int               @default(0)
  latencyMs       Int                @default(0)

  createdAt       DateTime           @default(now())
  expiresAt       DateTime           // suggestions auto-expire after 7 days

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, sourceType, sourceId])
  @@index([expiresAt])
  @@map("ai_suggestions")
}

// ─────────────────────────────────────────────
// AI ANOMALY — flagged irregularities for human review
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────
model AiAnomaly {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @db.Uuid

  type            AnomalyType
  severity        AnomalySeverity
  description     String
  explanation     String          @db.Text

  relatedIds      Json            // { invoiceId, journalId, duplicateId, ... }

  status          AnomalyStatus   @default(open)
  resolvedByUserId String?
  resolvedAt      DateTime?

  createdAt       DateTime        @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("ai_anomalies")
}

// ─────────────────────────────────────────────
// AI LOG — audit trail for every AI call
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────
model AiLog {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @db.Uuid
  userId          String?    @db.Uuid

  feature         AiFeature
  inputHash       String     // SHA-256 of prompt (for dedup analysis)
  tokensUsed      Int        @default(0)
  latencyMs       Int        @default(0)
  success         Boolean
  errorMessage    String?

  createdAt       DateTime   @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, feature])
  @@map("ai_logs")
}

// ─────────────────────────────────────────────
// ACCOUNTANT MODE — Agency client snapshots, bulk jobs, pins
// ─────────────────────────────────────────────

// Pre-computed health snapshot for each agency↔client pair.
// Updated hourly by cron; lets the agency dashboard load in one query.
model ClientSnapshot {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId    String @db.Uuid
  clientId    String @db.Uuid
  clientName  String
  clientSlug  String

  // Health (0–100)
  healthScore              Int     @default(0)

  // Invoice metrics
  overdueInvoiceCount      Int     @default(0)
  overdueAmountOre         BigInt  @default(0)

  // Supplier invoice backlog
  unbookedSupplierCount    Int     @default(0)

  // AI signals
  openAiAnomalyCount       Int     @default(0)
  pendingAiSuggestionCount Int     @default(0)

  // Activity
  daysSinceLastActivity    Int?    // null = never posted

  // Upcoming deadlines
  nextVatDeadlineAt   DateTime?
  vatDeadlineDaysLeft Int?
  fiscalYearEndsAt    DateTime?
  fiscalYearDaysLeft  Int?

  // Onboarding
  onboardingDone   Boolean @default(false)
  onboardingChecks Json    @default("{}")  // OnboardingChecks object

  // Task summary
  openTaskCount    Int @default(0)
  overdueTaskCount Int @default(0)

  // Serialised alerts for fast rendering
  alerts       Json @default("[]")   // Alert[]
  alertCount   Int  @default(0)
  errorCount   Int  @default(0)
  warningCount Int  @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agency Organization @relation("AgencyClientSnapshots", fields: [agencyId], references: [id], onDelete: Cascade)
  client Organization @relation("ClientOrgSnapshots",    fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([agencyId, clientId])
  @@index([agencyId, healthScore])
  @@index([agencyId, alertCount(sort: Desc)])
  @@index([agencyId, computedAt])
  @@map("client_snapshots")
}

// Async bulk operation kicked off by an agency user.
model BulkJob {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId        String   @db.Uuid
  createdByUserId String   @db.Uuid

  type      String   // "refresh_snapshots" | "send_reminder" | "vat_calculate" | "export_report"
  clientIds String[] // target client org IDs

  status    String @default("pending") // pending | running | done | failed | cancelled
  progress  Int    @default(0)         // 0–100
  total     Int    @default(0)
  processed Int    @default(0)

  result       Json?   // { succeeded: string[], failed: { id, error }[] }
  errorMessage String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  agency Organization @relation("AgencyBulkJobs", fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([agencyId, createdAt(sort: Desc)])
  @@map("bulk_jobs")
}

// Per-staff pinned clients — shown at top of list and in Cmd+K switcher.
model AgencyClientPin {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyMemberId String @db.Uuid
  clientId       String @db.Uuid
  sortOrder      Int    @default(0)

  agencyMember OrganizationMember @relation("MemberPins",   fields: [agencyMemberId], references: [id], onDelete: Cascade)
  client       Organization       @relation("PinnedClients", fields: [clientId],       references: [id], onDelete: Cascade)

  @@unique([agencyMemberId, clientId])
  @@index([agencyMemberId, sortOrder])
  @@map("agency_client_pins")
}

// Per-user per-org opt-out preferences. Row only exists when user changes a default.
model NotificationPreference {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  organizationId  String    @db.Uuid
  category        String

  inApp           Boolean   @default(true)
  email           Boolean   @default(true)
  emailDigest     Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, category])
  @@index([userId, organizationId])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────
// GLOBAL SEARCH INDEX
// Denormalized single-table index for full-text and fuzzy search.
// Populated inline on entity writes + nightly full re-index cron.
// TENANT-SCOPED: organization_id required on every query.
// ─────────────────────────────────────────────
model SearchIndex {
  id             String @id @default(cuid())
  organizationId String @db.Uuid

  entityType String // "contact" | "invoice" | "supplier_invoice" | "product" | "journal" | "member"
  entityId   String @db.Uuid

  title    String
  subtitle String?
  keywords String  @db.Text  // concatenated searchable text; full-text index built on this

  // Relative URL within the org, e.g. "/invoices/abc123"
  // Frontend prepends "/{orgSlug}" when navigating.
  url String

  metadata  Json     @default("{}")
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId])
  @@index([organizationId, entityType])
  @@map("search_index")
}

// ─────────────────────────────────────────────
// TASK SYSTEM
// Internal tasks, reminders, and assignments
// for bookkeeping administration.
// TENANT-SCOPED: organization_id required.
// ─────────────────────────────────────────────

enum TaskStatus {
  open
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  normal
  high
  urgent

  @@map("task_priority")
}

enum TaskEntityType {
  contact
  invoice
  supplier_invoice
  journal
  project
  contract

  @@map("task_entity_type")
}

model Task {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid

  title          String
  description    String?       @db.Text
  status         TaskStatus    @default(open)
  priority       TaskPriority  @default(normal)

  // Polymorphic link to source entity (optional)
  entityType     TaskEntityType?
  entityId       String?        @db.Uuid

  // Scheduling
  dueDate        DateTime?
  remindAt       DateTime?     // when to fire a reminder notification
  remindedAt     DateTime?     // set when reminder was sent

  // Completion
  completedAt       DateTime?
  completedByUserId String?    @db.Uuid

  // Soft delete
  deletedAt DateTime?

  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation("OrgTasks",        fields: [organizationId],   references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreatedBy",   fields: [createdByUserId],  references: [id])
  completedBy  User?        @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])

  assignments  TaskAssignment[]
  comments     TaskComment[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdByUserId])
  @@map("tasks")
}

model TaskAssignment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String   @db.Uuid
  userId           String   @db.Uuid
  organizationId   String   @db.Uuid
  assignedByUserId String   @db.Uuid
  assignedAt       DateTime @default(now())

  task       Task @relation(fields: [taskId],           references: [id], onDelete: Cascade)
  user       User @relation("AssignedTasks",            fields: [userId],            references: [id])
  assignedBy User @relation("TasksAssignedByMe",        fields: [assignedByUserId],  references: [id])
  organization Organization @relation("OrgTaskAssignments", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, organizationId])
  @@index([organizationId])
  @@map("task_assignments")
}

model TaskComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String   @db.Uuid
  organizationId String   @db.Uuid
  authorId       String   @db.Uuid

  body      String   @db.Text
  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task         Task         @relation(fields: [taskId],         references: [id], onDelete: Cascade)
  author       User         @relation("TaskCommentAuthor",      fields: [authorId],       references: [id])
  organization Organization @relation("OrgTaskComments",        fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId, authorId])
  @@map("task_comments")
}

