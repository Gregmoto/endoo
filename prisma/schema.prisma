// ─── ACCOUNTING ENUMS ─────────────────────────────────────────────────────────

// Which side of the T-account increases the balance
enum NormalSide {
  debit
  credit
}

enum FiscalYearStatus {
  open    // new journals allowed
  closed  // period closed, no new journals (but can still void with new journal in open year)
  locked  // archived — no mutations at all
}

enum ConnectionStatus {
  pending       // auth not completed
  active        // connected and working
  error         // auth failure or repeated sync errors
  disconnected  // user-initiated disconnect
}

enum WebhookEventStatus {
  pending    // waiting to be processed
  processing // claimed by processor
  processed  // successfully handled
  failed     // exhausted retries
  skipped    // ignored (duplicate, unsupported topic)
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
}

enum ImportFileStatus {
  preview    // parsed, not committed
  committed  // fully imported
  failed     // import errored
}

enum ProjectStatus {
  planning    // skapad men ej startad
  active      // pågående
  on_hold     // pausad
  completed   // avslutad — inga nya postningar
  archived    // arkiverad — dold i UI
}

enum AccountingPeriodStatus {
  open    // new journals allowed
  locked  // soft lock — admins can unlock with mandatory reason
  closed  // hard close — only platform admins can reopen
}

enum AccountingPeriodEventType {
  opened
  locked
  unlocked
  closed
  reopened
}

enum JournalStatus {
  draft   // editable, not in reports
  posted  // immutable, visible in reports
  voided  // reversed by a later journal, still visible in history
}

// Where the account appears in financial statements
enum ReportClass {
  balance_sheet       // 1xxx + 2xxx
  income_statement    // 3xxx–8xxx
}

// Accounting type — drives sign convention in reports
enum AccountType {
  asset       // 1xxx  — DR normal
  liability   // 2xxx  — CR normal
  equity      // 2xxx  — CR normal
  income      // 3xxx  — CR normal
  expense     // 4xxx–8xxx — DR normal
}

// ─── SUPPLIER INVOICE ENUMS ───────────────────────────────────────────────────

enum SupplierInvoiceStatus {
  draft            // uploaded, extraction not started
  extracting       // AI is processing right now
  needs_review     // extraction done, awaiting user confirmation
  pending_approval // sent to attest workflow — locked for editing
  approved         // all steps approved (or no policy) — ready to book
  booked           // journal created and posted
  paid             // payment journal created
  rejected         // user rejected (duplicate or invalid)
}

enum ExtractionStatus {
  pending
  processing
  completed
  failed
}

enum VatPeriodType {
  monthly
  quarterly
  yearly
}

enum VatPeriodStatus {
  open
  calculated
  submitted
  locked
}

enum ApiKeyEnv {
  live
  test
}

// ─── APPROVAL WORKFLOW ENUMS ──────────────────────────────────────────────────

enum ApproverType {
  specific_user   // a named user ID
  role_based      // any member with the given MemberRole
}

enum CompletionRule {
  any_one    // first approval clears the step
  all_must   // every resolved approver must vote
}

enum ApprovalRequestStatus {
  in_progress
  approved
  rejected
  withdrawn
}

enum ApprovalStepStatus {
  pending   // waiting for previous step
  active    // current — approvers can vote
  approved
  rejected
}

enum VoteDecision {
  approved
  rejected
}

