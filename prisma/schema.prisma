// ─────────────────────────────────────────────
// E-SIGNERING
// ─────────────────────────────────────────────

enum SignatureRequestStatus {
  draft             // skapad, ej skickad
  sent              // skickad, väntar på signerare
  partially_signed  // minst en signerare klar
  completed         // alla signerare klara
  declined          // någon avböjde
  expired           // löpte ut utan completion
  cancelled         // avsändaren avbröt
}

enum SignerStatus {
  pending   // invite skickat, ej öppnat
  viewed    // öppnat signeringssidan
  signed    // har signerat
  declined  // avböjt
}

enum QuoteStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
  cancelled
  invoiced
  contracted
}

enum SignatureEventType {
  created
  sent
  viewed
  signed
  declined
  reminder_sent
  partially_signed
  completed
  cancelled
  expired
  resent
}

model SignatureRequest {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid

  // Linked entity — "contract" = RecurringSchedule, "quote" = Invoice (type=quote)
  entityType     String  // "contract" | "quote"
  entityId       String  @db.Uuid

  // Document snapshot frozen at send time
  title               String
  message             String?
  documentSnapshotUrl String?
  documentHash        String?   // SHA-256 of PDF bytes at send time

  // Config
  expiresAt      DateTime
  reminderDays   Int[]     @default([3, 7, 14])

  // Status
  status         SignatureRequestStatus @default(draft)
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  createdByUserId String  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation("OrgSignatureRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("SignatureRequestCreatedBy", fields: [createdByUserId], references: [id])
  signers      Signer[]
  events       SignatureEvent[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([expiresAt])
  @@map("signature_requests")
}

model Signer {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signatureRequestId String @db.Uuid

  // Identity
  name         String
  email        String
  role         String @default("signer")  // "signer" | "cc"
  signingOrder Int    @default(0)

  // Token — raw token sent in email, only hash stored in DB
  tokenHash      String   @unique
  tokenExpiresAt DateTime

  // Status
  status     SignerStatus @default(pending)
  viewedAt   DateTime?
  signedAt   DateTime?
  declinedAt DateTime?
  declineReason String?

  // Evidence
  signatureText String?
  ipAddress     String?
  userAgent     String?

  // Reminders
  lastRemindedAt DateTime?
  reminderCount  Int       @default(0)

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  events           SignatureEvent[]

  @@index([signatureRequestId])
  @@index([tokenHash])
  @@map("signers")
}

model SignatureEvent {
  id                 String @id @default(cuid())
  signatureRequestId String @db.Uuid
  signerId           String? @db.Uuid

  eventType    SignatureEventType
  ipAddress    String?
  userAgent    String?
  documentHash String?
  meta         Json    @default("{}")

  createdAt DateTime @default(now())

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  signer           Signer?         @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([signatureRequestId, createdAt])
  @@map("signature_events")
}

// ─────────────────────────────────────────────
// PORTAL — customer self-service portal
// ─────────────────────────────────────────────

model PortalMagicToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  email          String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

