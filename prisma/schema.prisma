// ─────────────────────────────────────────────
// ORGANIZATIONS — tenants
// Every paying account is one row here.
// type = 'agency'   → has agency_client_relationships
// type = 'customer' → standalone or managed by an agency
// ─────────────────────────────────────────────
model Organization {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String           @unique                // URL path: endoo.se/app/{slug}
  name      String
  type      OrganizationType
  plan      Plan             @default(free)
  planExpiresAt DateTime?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Branding (for PDF invoices)
  logoUrl      String?
  primaryColor String?          // hex

  // Invoice defaults
  invoicePrefix        String  @default("INV")
  invoiceSequenceStart Int     @default(1)
  defaultCurrency      String  @default("SEK")
  defaultTaxRate       Decimal @default(0.25) @db.Decimal(5, 4)
  defaultPaymentTermsDays Int  @default(30)

  // Invoicing v2 settings (JSON blob for all configurable defaults)
  invoicingSettings    Json?

  // Locale
  locale   String @default("sv-SE")
  timezone String @default("Europe/Stockholm")

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String  @default("SE")

  // Contact
  phone        String?
  website      String?
  contactEmail String?  // publik kontaktadress (≠ inloggnings-e-post)

  // Swedish identifiers
  vatNumber String?
  orgNumber String?     // organisationsnummer

  // Banking
  bankName    String?
  bankAccount String?   // stored encrypted at app layer
  bankgiro    String?
  plusgiro    String?
  iban        String?
  bic         String?

  isActive Boolean @default(true)
  metadata Json    @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  members               OrganizationMember[]
  invitations           Invitation[]

  // Agency side: agencies this org manages
  agencyRelationships   AgencyClientRelationship[] @relation("AgencyOrg")
  // Client side: agencies managing this org
  clientRelationships   AgencyClientRelationship[] @relation("ClientOrg")

  contacts              Contact[]
  contactPersons        ContactPerson[]
  products              Product[]
  invoices              Invoice[]
  invoiceLineItems      InvoiceLineItem[]
  payments              Payment[]
  unmatchedPayments     UnmatchedPayment[]
  recurringSchedules    RecurringSchedule[]
  recurringScheduleLines RecurringScheduleLine[]
  settings              OrganizationSetting[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]

  // Agency access grants for this client org
  staffAccessGrants     AgencyStaffAccess[]     @relation("ClientStaffAccess")

  // Sessions currently active in this org
  activeSessions        Session[]               @relation("ActiveOrgSessions")
  impersonatingSessions Session[]               @relation("ImpersonatingOrgSessions")

  // Invoices created on behalf of this org (by an agency)
  invoicesCreatedOnBehalf Invoice[]             @relation("AgencyCreatedInvoices")

  // Accounting
  accounts              Account[]
  fiscalYears           FiscalYear[]
  journalSeries         JournalSeries[]
  journals              Journal[]
  journalEntries        JournalEntry[]
  accountingPeriods     AccountingPeriod[]
  accountingPeriodEvents AccountingPeriodEvent[]

  // Dimensions
  dimensionAxes         DimensionAxis[]
  dimensions            Dimension[]
  journalEntryDimensions JournalEntryDimension[]
  invoiceLineDimensions  InvoiceLineItemDimension[]
  supplierInvoiceDimensions SupplierInvoiceDimension[]
  accountDimensionRules  AccountDimensionRule[]

  // Integrations
  connections       Connection[]
  webhookEvents     WebhookEvent[]
  syncJobs          SyncJob[]
  integrationLogs   IntegrationLog[]
  externalEntityMaps ExternalEntityMap[]
  importFiles       ImportFile[]

  // Supplier invoices
  suppliers             Supplier[]
  supplierInvoices      SupplierInvoice[]

  // VAT
  vatPeriods            VatPeriod[]

  // Inventory
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]

  // Fixed assets
  fixedAssets           FixedAsset[]
  depreciationSchedules DepreciationSchedule[]

  // Accruals
  accruals              Accrual[]
  accrualPeriods        AccrualPeriod[]

  // SIE import
  sieImportJobs         SieImportJob[]

  // SRU export
  sruExports            SruExport[]

  // Invoicing v2
  paymentTerms          PaymentTerm[]
  units                 Unit[]
  currencies            OrgCurrency[]
  deliveryMethods       DeliveryMethod[]
  deliveryTerms         DeliveryTerms[]
  priceLists            PriceList[]
  accountMappings       AccountMapping[]
  manualReservations    ManualReservation[]
  invoiceTemplates      InvoiceTemplate2[]
  exchangeRates         ExchangeRate[]

  // API platform
  apiKeys               ApiKey[]
  idempotencyKeys       IdempotencyKey[]

  // Approval workflow
  approvalPolicies      ApprovalPolicy[]
  approvalRequests      ApprovalRequest[]

  // Notifications
  notificationEvents      NotificationEvent[]
  activityFeedItems       ActivityFeedItem[]
  notifications           Notification[]
  notificationJobs        NotificationJob[]
  notificationPreferences NotificationPreference[]

  // Search
  searchIndex SearchIndex[]

  // Tasks
  tasks            Task[]            @relation("OrgTasks")
  taskAssignments  TaskAssignment[]  @relation("OrgTaskAssignments")
  taskComments     TaskComment[]     @relation("OrgTaskComments")

  // Calendar
  calendarEvents CalendarEvent[]

  // AI
  aiSuggestions AiSuggestion[]
  aiAnomalies   AiAnomaly[]
  aiLogs        AiLog[]

  // Accountant mode
  agencySnapshots  ClientSnapshot[] @relation("AgencyClientSnapshots")
  clientSnapshots  ClientSnapshot[] @relation("ClientOrgSnapshots")
  bulkJobs         BulkJob[]        @relation("AgencyBulkJobs")
  pinnedByStaff    AgencyClientPin[] @relation("PinnedClients")

  // Analytics
  analyticsSnapshots AnalyticsSnapshot[] @relation("OrgAnalyticsSnapshots")
  monthlyMetrics     MonthlyMetric[]     @relation("OrgMonthlyMetrics")

  // White-label branding
  brandingProfile          BrandingProfile?
  emailDomainVerifications EmailDomainVerification[]

  // Email delivery tracking
  emailDeliveries    EmailDelivery[]
  emailSuppressions  EmailSuppression[]

  // E-signering
  signatureRequests SignatureRequest[] @relation("OrgSignatureRequests")
  quotes            Quote[]            @relation("OrgQuotes")
  portalMagicTokens  PortalMagicToken[]  @relation("OrgPortalTokens")
  portalAuthAttempts PortalAuthAttempt[] @relation("OrgPortalAuthAttempts")
  trustedDevices     TrustedDevice[]     @relation("OrgTrustedDevices")

  @@index([slug])
  @@index([type])
  @@index([stripeCustomerId])
  @@map("organizations")
}

// ─────────────────────────────────────────────
// AGENCY ↔ CLIENT RELATIONSHIPS
// An Agency manages one or more client Organizations.
// tenant-scoped: NO (cross-tenant by nature)
// ─────────────────────────────────────────────
model AgencyClientRelationship {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId String             @db.Uuid
  clientId String             @db.Uuid
  status   RelationshipStatus @default(active)

  grantedAt DateTime  @default(now())
  grantedBy String?   @db.Uuid   // user_id who created the link
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Organization @relation("AgencyOrg", fields: [agencyId], references: [id], onDelete: Cascade)
  client Organization @relation("ClientOrg", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([agencyId, clientId])
  @@index([agencyId])
  @@index([clientId])
  @@map("agency_client_relationships")
}

// ─────────────────────────────────────────────
// USERS — global identity, no org affiliation here
// A user gets roles through OrganizationMember rows.
// ─────────────────────────────────────────────
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  fullName        String
  avatarUrl       String?

  locale   String @default("sv-SE")
  timezone String @default("Europe/Stockholm")

  lastLoginAt     DateTime?
  lastLoginIp     String?
  lastSeenVersion String?   // for WhatsNewModal — updated on dismiss

  // Super Admin — bypasses all tenant RLS
  isPlatformAdmin Boolean @default(false)

  // 2FA
  totpSecret    String?   // encrypted at app layer
  totpEnabled   Boolean   @default(false)
  recoveryCodes String[]  // hashed

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  accounts     UserAccount[]
  sessions     Session[]
  memberships  OrganizationMember[]
  invitationsSent Invitation[]
  auditLogs    AuditLog[]

  // Agency staff grants (this user → client orgs)
  staffAccessGrants AgencyStaffAccess[]

  invoicesCreated  Invoice[]   @relation("InvoiceCreatedBy")
  paymentsCreated  Payment[]   @relation("PaymentCreatedBy")
  schedulesCreated RecurringSchedule[] @relation("ScheduleCreatedBy")
  managedContacts      Contact[]            @relation("AccountManagerContacts")
  manualReservations   ManualReservation[]  @relation("ManualReservations")
  signatureRequestsCreated SignatureRequest[] @relation("SignatureRequestCreatedBy")
  quotesCreated            Quote[]           @relation("QuoteCreatedBy")

  // Accounting
  journalsPosted      Journal[]              @relation("JournalPostedBy")
  journalsCreated     Journal[]              @relation("JournalCreatedBy")
  periodsLocked       AccountingPeriod[]     @relation("PeriodLockedBy")
  periodsClosed       AccountingPeriod[]     @relation("PeriodClosedBy")
  periodEvents        AccountingPeriodEvent[] @relation("PeriodEventUser")
  fiscalYearsClosed   FiscalYear[]           @relation("FiscalYearClosedBy")
  fiscalYearsReopened FiscalYear[]           @relation("FiscalYearReopenedBy")

  // Dimensions
  dimensionsOwned     Dimension[]            @relation("DimensionOwner")
  dimensionForces     JournalEntryDimension[] @relation("DimensionForceUser")

  // Integrations
  importFilesUploaded ImportFile[]           @relation("ImportFileUser")
  sieImportJobs       SieImportJob[]         @relation("SieImportJobUser")
  generatedSruExports SruExport[]            @relation("SruExportUser")

  // Tasks
  tasksCreated     Task[]           @relation("TaskCreatedBy")
  tasksCompleted   Task[]           @relation("TaskCompletedBy")
  taskAssignments  TaskAssignment[] @relation("AssignedTasks")
  taskAssignedByMe TaskAssignment[] @relation("TasksAssignedByMe")
  taskComments     TaskComment[]    @relation("TaskCommentAuthor")

  // Calendar
  calendarEventsCreated  CalendarEvent[]        @relation("CalendarEventCreator")
  calendarEventAttendees CalendarEventAttendee[] @relation("CalendarEventAttendees")

  @@index([email])
  @@index([isPlatformAdmin])
  @@map("users")
}

// ─────────────────────────────────────────────
// USER ACCOUNTS — OAuth / credential providers
// NextAuth.js compatible
// ─────────────────────────────────────────────
model UserAccount {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String   // 'oauth' | 'email' | 'credentials'
  provider          String   // 'google' | 'github' | 'email'
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         BigInt?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_accounts")
}

// ─────────────────────────────────────────────
// ORGANIZATION MEMBERS — user ↔ org many-to-many
// Role is per membership, not global.
// Account switching = changing active_organization_id in session.
// ─────────────────────────────────────────────
model OrganizationMember {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole

  invitedBy  String?   @db.Uuid
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  // Marks the user's "home" org (shown first after login)
  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Agency staff can have explicit per-client access grants
  staffAccessGrants AgencyStaffAccess[]

  // Accountant mode
  clientPins AgencyClientPin[] @relation("MemberPins")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

// ─────────────────────────────────────────────
// AGENCY STAFF ACCESS — per-staff client access
// An agency owner implicitly accesses all clients.
// Non-owner agency staff need explicit grants here.
// ─────────────────────────────────────────────
model AgencyStaffAccess {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyMemberId String            @db.Uuid  // OrganizationMember in agency
  clientId       String            @db.Uuid  // client Organization
  accessLevel    AgencyAccessLevel @default(full)

  grantedBy String   @db.Uuid
  grantedAt DateTime @default(now())
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencyMember OrganizationMember @relation(fields: [agencyMemberId], references: [id], onDelete: Cascade)
  client       Organization       @relation("ClientStaffAccess", fields: [clientId], references: [id], onDelete: Cascade)
  grantedByUser User              @relation(fields: [grantedBy], references: [id])

  @@unique([agencyMemberId, clientId])
  @@index([agencyMemberId])
  @@index([clientId])
  @@map("agency_staff_access")
}

// ─────────────────────────────────────────────
// INVITATIONS — pending membership invites
// ─────────────────────────────────────────────
model Invitation {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  email          String
  role           MemberRole
  token          String     @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')"))

  invitedBy  String   @db.Uuid
  expiresAt  DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'"))
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUser User        @relation(fields: [invitedBy], references: [id])

  @@unique([organizationId, email])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ─────────────────────────────────────────────
// SESSIONS — NextAuth + account switching context
// active_organization_id  = current tenant context
// impersonating_org_id    = agency acting as client
// ─────────────────────────────────────────────
model Session {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String  @unique
  userId       String  @db.Uuid
  expires      DateTime

  // Account switching state (stored in session, not JWT)
  activeOrganizationId       String? @db.Uuid
  impersonatingOrganizationId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization       Organization? @relation("ActiveOrgSessions", fields: [activeOrganizationId], references: [id])
  impersonatingOrganization Organization? @relation("ImpersonatingOrgSessions", fields: [impersonatingOrganizationId], references: [id])

  @@index([sessionToken])
  @@index([userId])
  @@map("sessions")
}

// NextAuth verification tokens (magic links / email OTP)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// CONTACTS — the customers you invoice
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────
model Contact {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  type         String @default("business") // 'business' | 'individual'
  customerType String @default("business") // business | individual
  name         String
  email        String?
  phone        String?
  phone2       String?
  fax          String?
  countryCode  String?  // dialing prefix e.g. "+46"
  website      String?

  // Swedish identifiers
  vatNumber      String?
  orgNumber      String?
  personalNumber String?  @db.VarChar(13) // YYYYMMDD-NNNN for individuals

  // Billing address
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String  @default("SE")

  // Delivery address
  deliveryLine1      String?
  deliveryLine2      String?
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryCountry    String?

  // Visiting address
  visitingLine1      String?
  visitingLine2      String?
  visitingPostalCode String?
  visitingCity       String?
  visitingCountry    String?

  // Status & classification
  status         ContactStatus @default(active)
