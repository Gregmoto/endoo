  pendingCode    String?

  organization Organization @relation("OrgPortalTokens", fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation("ContactPortalTokens", fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
  @@map("portal_magic_tokens")
}

model PortalAuthAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  contactId      String?  @db.Uuid
  email          String
  ip             String
  userAgent      String
  success        Boolean
  failureReason  String?
  createdAt      DateTime @default(now())

  organization Organization @relation("OrgPortalAuthAttempts", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ip, createdAt])
  @@map("portal_auth_attempts")
}

model TrustedDevice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  contactId      String    @db.Uuid
  deviceId       String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label          String?
  lastUsedAt     DateTime  @default(now())
  ipPrefix       String
  userAgent      String
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation("OrgTrustedDevices", fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation("ContactTrustedDevices", fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId])
  @@index([deviceId])
  @@map("trusted_devices")
}

// ─────────────────────────────────────────────
// QUOTES — sales offers sent to contacts
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────
model Quote {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  number         String      // Q-2026-0001

  title          String?
  status         QuoteStatus @default(draft)

  // Mottagare (kopieras vid skapande)
  contactId      String?     @db.Uuid
  contactName    String
  contactEmail   String?
  contactAddress Json?

  // Radposter (JSON array av QuoteLineItem)
  lineItems      Json        @default("[]")
  currency       String      @default("SEK")

  // Rabatt på total nivå
  discount       Decimal?    @db.Decimal(12, 2)
  discountType   String?     // "percent" | "amount"

  // Text
  notes          String?
  terms          String?
  internalNote   String?

  // Tidpunkter
  validUntil     DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  respondedAt    DateTime?
  responseNote   String?

  // Godkännandetoken — raw skickas i email, hash lagras
  approvalTokenHash      String?   @unique
  approvalTokenExpiresAt DateTime?

  // Konvertering
  convertedToInvoiceId   String?   @db.Uuid
  convertedToContractId  String?   @db.Uuid
  convertedAt            DateTime?

  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation("OrgQuotes", fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([contactId])
  @@map("quotes")
}

