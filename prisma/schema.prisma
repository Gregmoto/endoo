// ─────────────────────────────────────────────────────────────────────────────
// FIXED ASSETS — Anläggningstillgångar
// TENANT-SCOPED: organizationId required on every query
// ─────────────────────────────────────────────────────────────────────────────

enum DepreciationMethod {
  linear            // linjär avskrivning
  declining_balance // degressiv avskrivning
  tax_book          // räkenskapsenlig (30% declining-balance)
}

enum FixedAssetStatus {
  active      // in use
  disposed    // sold or scrapped — final
  written_off // fully depreciated — final
}

enum DepreciationScheduleStatus {
  planned   // not yet posted
  posted    // journal created and posted
  reversed  // reversed by a later journal
}

model FixedAsset {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  assetNumber String  // e.g. "AT-2026-0001", unique per org
  name        String
  description String? @db.Text
  category    String  // "Datorer", "Maskiner", "Inventarier", etc.

  // Linked accounts (BAS account numbers as strings)
  assetAccount                   String  // e.g. "1220" — DR on acquisition
  depreciationAccount            String  // e.g. "7832" — DR on depreciation charge
  accumulatedDepreciationAccount String  // e.g. "1229" — CR on depreciation charge

  // Acquisition
  acquisitionDate DateTime @db.Date
  acquisitionCost BigInt               // öre
  residualValue   BigInt  @default(0) // öre — ignored in tax_book

  // Depreciation policy
  usefulLifeMonths   Int
  depreciationMethod DepreciationMethod
  declineRate        Decimal? @db.Decimal(6, 4) // e.g. 0.2000 for 20%; null for linear/tax_book

  // Status
  status          FixedAssetStatus @default(active)
  disposalDate    DateTime?        @db.Date
  disposalProceeds BigInt?          // öre
  disposalJournalId String?         @db.Uuid

  // Optional link to the supplier invoice that created this asset
  supplierInvoiceId String? @db.Uuid

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierInvoice SupplierInvoice?  @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  schedules       DepreciationSchedule[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, acquisitionDate])
  @@map("fixed_assets")
}

model DepreciationSchedule {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  fixedAssetId   String @db.Uuid

  period              String  // "YYYY-MM"
  depreciationAmount  BigInt  // öre, monthly charge
  accumulatedAmount   BigInt  // öre, cumulative after this period
  bookValue           BigInt  // öre, after this period

  journalId String? @db.Uuid // null until posted
  status    DepreciationScheduleStatus @default(planned)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fixedAsset   FixedAsset   @relation(fields: [fixedAssetId],   references: [id], onDelete: Cascade)

  @@unique([organizationId, fixedAssetId, period])
  @@index([organizationId, period, status])
  @@index([fixedAssetId])
  @@map("depreciation_schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACCRUALS — Periodiseringar (interimsposter)
// TENANT-SCOPED: organization_id required
// ─────────────────────────────────────────────────────────────────────────────

enum AccrualType {
  prepaid_expense  // Förutbetald kostnad  (DR 17xx, CR 5xxx/6xxx)
  accrued_expense  // Upplupet kostnad     (DR 5xxx/6xxx, CR 29xx)
  prepaid_revenue  // Förutbetald intäkt   (DR 3xxx, CR 28xx)
  accrued_revenue  // Upplupen intäkt      (DR 17xx, CR 3xxx)
}

enum AccrualStatus {
  active     // in progress — some periods may be posted
  completed  // all periods posted
  reversed   // fully reversed
}

enum AccrualPeriodStatus {
  planned
  posted
}

model Accrual {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  accrualNumber String  // "AC-2026-0001", unique per org
  type          AccrualType
  description   String  @db.Text

  totalAmount BigInt  // öre
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  periodCount Int      // derived: months between start and end inclusive

  mainAccount    String  // e.g. "5010" — the P&L account
  accrualAccount String  // e.g. "1710" — the balance sheet accrual account

  // Source document (optional)
  sourceType String?  // "supplier_invoice" | "invoice" | "manual"
  sourceId   String?  @db.Uuid

  status AccrualStatus @default(active)
  notes  String?       @db.Text

  createdByUserId String? @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      AccrualPeriod[]

  @@unique([organizationId, accrualNumber])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, startDate])
  @@map("accruals")
}

model AccrualPeriod {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  accrualId      String @db.Uuid

  period    String  // "YYYY-MM"
  amount    BigInt  // öre — may differ from totalAmount/periodCount due to rounding
  journalId String? @db.Uuid
  status    AccrualPeriodStatus @default(planned)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accrual      Accrual      @relation(fields: [accrualId],      references: [id], onDelete: Cascade)

  @@unique([organizationId, accrualId, period])
  @@index([organizationId, period, status])
  @@index([accrualId])
  @@map("accrual_periods")
}

// ─────────────────────────────────────────────────────────────────────────────
// SIE IMPORT
// ─────────────────────────────────────────────────────────────────────────────

enum SieImportStatus {
  pending     // file uploaded, not yet parsed
  previewed   // dry-run complete, awaiting confirmation
  importing   // executing import
  completed   // import done
  failed      // errored
}

model SieImportJob {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid

  fileName    String
  fileSize    Int               // bytes
  fileHash    String            // SHA-256 for dedup
  charset     String            @default("CP437")
  sieType     Int?              // 4 (4i) or 4 (4e) — from #SIETYP
  rawContent  String            @db.Text  // base64-encoded file content

  status      SieImportStatus   @default(pending)
  previewData Json?             // ParsedSiePreview
  importOptions Json?           // ImportSieOptions used
  importResult  Json?           // ImportSieResult

  errorMessage     String?      @db.Text
  importedByUserId String?      @db.Uuid
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importedBy   User?        @relation("SieImportJobUser", fields: [importedByUserId], references: [id])

  @@unique([organizationId, fileHash])
  @@index([organizationId, status])
  @@map("sie_import_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SRU EXPORT
// ─────────────────────────────────────────────────────────────────────────────

enum SruExportType {
  k2    // K2 (BFNAR 2016:10) accounting framework
  k3    // K3 (BFNAR 2012:1) accounting framework
  ink2  // INK2 corporate income tax declaration
}

enum SruExportStatus {
  draft  // generated, not yet submitted to Skatteverket
  final  // marked as submitted by user
}

model SruExport {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  fiscalYearId   String          @db.Uuid

  type           SruExportType
  status         SruExportStatus @default(draft)

  infoSru        String          @db.Text  // content of INFO.SRU
  blankettSru    String          @db.Text  // content of BLANKETTER.SRU

  generatedByUserId String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear    FiscalYear   @relation(fields: [fiscalYearId],   references: [id], onDelete: Restrict)
  generatedBy   User?        @relation("SruExportUser", fields: [generatedByUserId], references: [id])

  @@index([organizationId, fiscalYearId])
  @@index([organizationId, status])
  @@map("sru_exports")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEMA VERSIONING (platform-scoped, not tenant-scoped)
