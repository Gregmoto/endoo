  deliveryTermsId       String?  @db.Uuid

  // Fees & discounts
  freightAmount         BigInt   @default(0)
  invoiceFeeAmount      BigInt   @default(0)
  invoiceDiscountRate   Decimal? @db.Decimal(5, 4)

  // Denormalized computed totals (v2)
  netAmount             BigInt   @default(0)
  grossAmount           BigInt   @default(0)
  roundingAmount        BigInt   @default(0)
  freeText              String?  @db.Text
  shipmentMark          String?
  cashAccount           String?

  // Inventory
  inventoryUpdated      Boolean  @default(false)
  inventoryUpdatedAt    DateTime?

  // Interest invoice relations
  parentInvoiceId       String?  @db.Uuid
  isInterestInvoice     Boolean  @default(false)
  reminderFeeApplied    Boolean  @default(false)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  creditedInvoice Invoice?     @relation("CreditNote", fields: [creditedInvoiceId], references: [id])
  creditNotes     Invoice[]    @relation("CreditNote")
  recurringSchedule RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  createdByUser  User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  agencyCreator  Organization? @relation("AgencyCreatedInvoices", fields: [createdOnBehalfOfAgencyId], references: [id])

  lineItems       InvoiceLineItem[]
  payments        Payment[]
  parentInvoice   Invoice?          @relation("InterestInvoice", fields: [parentInvoiceId], references: [id])
  interestInvoices Invoice[]        @relation("InterestInvoice")
  priceList       PriceList?        @relation(fields: [priceListId], references: [id])
  deliveryMethod  DeliveryMethod?   @relation(fields: [deliveryMethodId], references: [id])
  deliveryTerms   DeliveryTerms?    @relation(fields: [deliveryTermsId], references: [id])

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([recurringScheduleId])
  @@map("invoices")
